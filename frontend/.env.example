NEXT_PUBLIC_EDUSTREAM_WS_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_EDUSTREAM_API_BASE_URL=http://127.0.0.1:8000
EDUSTREAM_API_BASE_URL=http://127.0.0.1:8000

# Optional WebRTC ICE configuration for reliable live media delivery.
# If omitted, the app falls back to a public Google STUN server.
NEXT_PUBLIC_EDUSTREAM_STUN_URLS=stun:stun.l.google.com:19302
NEXT_PUBLIC_EDUSTREAM_TURN_URLS=turn:your-turn-host:3478?transport=udp,turn:your-turn-host:3478?transport=tcp
NEXT_PUBLIC_EDUSTREAM_TURN_USERNAME=replace-me
NEXT_PUBLIC_EDUSTREAM_TURN_CREDENTIAL=replace-me

# Advanced option: provide full ICE server JSON instead of the vars above.
# Example:
# NEXT_PUBLIC_EDUSTREAM_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:your-turn-host:3478?transport=udp"],"username":"replace-me","credential":"replace-me"}]
