DEBUG=True
SECRET_KEY=django-insecure-edustream-classroom-local-dev-secret-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=edustream
POSTGRES_USER=edustream
POSTGRES_PASSWORD=edustream
POSTGRES_HOST=db
POSTGRES_PORT=5432
CHANNEL_LAYER_BACKEND=auto
# Base Redis URL (host[:port][auth]). Django cache uses DB 0, Channels uses DB 1 (same server, isolated keyspaces).
# You may set REDIS_URL=redis://redis:6379 (no DB) and settings will append /0 and /1.
REDIS_URL=redis://redis:6379/0
# Optional: override defaults (must include DB index in path)
# REDIS_CACHE_URL=redis://redis:6379/0
# CHANNEL_REDIS_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Absolute URLs for uploaded session materials (student dashboard links). Use your public API origin in production.
PUBLIC_BACKEND_BASE_URL=http://127.0.0.1:8000

# Ops: JSON metrics at /api/ops/metrics/ (501 if unset). Send X-Ops-Key.
# Optional legacy compatibility: set OPS_METRICS_ALLOW_QUERY_KEY=true to allow ?key=
OPS_METRICS_KEY=
OPS_METRICS_ALLOW_QUERY_KEY=false

# Optional: structured JSON logs (requires python-json-logger)
JSON_LOGS=false
LOG_LEVEL=INFO

# Optional error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
