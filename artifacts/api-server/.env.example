PORT=8080
NODE_ENV=development
SKIP_CLERK_AUTH=true

# PostgreSQL (required for student sign-up, teacher classes, admin)
# Create via: .\scripts\setup-postgres.ps1  (or see LOCAL credentials in setup output)
DATABASE_URL=postgresql://edustream:YOUR_PASSWORD@127.0.0.1:5432/edustream

# Clerk (teacher sign-in) — get keys from https://dashboard.clerk.com
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# SKIP_CLERK_AUTH=false

SESSION_SECRET=replace_with_random_secret_at_least_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
