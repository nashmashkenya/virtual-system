# Copy these into Railway → Project → Variables

# Required: Railway provides this automatically
PORT=3000

# Required: PostgreSQL (use Railway's Postgres plugin — it sets DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: Clerk (from clerk.com dashboard)
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Required: Session security (generate a random 32-char string)
SESSION_SECRET=replace_with_random_secret_at_least_32_chars

# Required: Admin credentials for /api/admin routes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password

# Set to production
NODE_ENV=production
