# Build stage
FROM node:24-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace config and lockfiles for cache
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy source
COPY . .

# Install and build only the frontend package
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/elimu-pawa run build

# Runtime: nginx to serve static files
FROM nginx:stable-alpine AS runtime

# Remove default conf and copy our SPA config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static files
COPY --from=builder /app/artifacts/elimu-pawa/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
